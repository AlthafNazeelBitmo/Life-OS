# Dart / Flutter
#
# `pubspec.lock` is deliberately NOT ignored. LifeOS is an application, not a
# library: committing the lockfile is what makes a CI run and a developer's
# machine resolve the same package versions, so a transitive patch release
# cannot turn the branch red without a commit to blame.
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.log

# Generated sources (regenerate with `dart run build_runner build`)
*.g.dart
*.freezed.dart
*.config.dart

# IDE
.idea/
.vscode/
*.iml
*.iws
.DS_Store

# Secrets — never commit these
.env
.env.*
!.env.example
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
*.jks
*.keystore
key.properties
ios/Runner/Runner.entitlements.local

# Platform folders are generated by `flutter create .` (see tool/bootstrap.sh).
# Uncomment the lines below if you prefer to keep them out of version control.
# android/
# ios/
# web/
# macos/
# linux/
# windows/

# Golden-test diff output. Regenerated on every failing run.
test/**/failures/
